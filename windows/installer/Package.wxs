<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-machine, 64-bit MSI. Installs the 64-bit and 32-bit text-service DLLs and registers
  both through their own DllRegisterServer (regsvr32), exactly what `windows/install.ps1`
  does. Unregisters before the files are removed on uninstall and upgrade.

  Build:  wix build -arch x64 -d Version=0.1.0 -d X64Dll=<path> -d X86Dll=<path> \
               -d Icon=windows\installer\sinhala.ico \
               windows\installer\Package.wxs -o SinhalaInput-0.1.0-x64.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Sinhala Input" Manufacturer="Itrowin" Version="$(Version)"
           UpgradeCode="3c147142-9558-4dd0-9ebc-62690c0279fd"
           Scope="perMachine" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Sinhala Input is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Icon Id="AppIcon" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SinhalaInput" />
    </StandardDirectory>

    <Feature Id="Main" Title="Sinhala Input" Level="1">
      <ComponentGroupRef Id="Binaries" />
    </Feature>

    <ComponentGroup Id="Binaries" Directory="INSTALLFOLDER">
      <Component Id="Dll64">
        <File Id="Dll64" Source="$(X64Dll)" Name="sinhala_tsf_x64.dll" KeyPath="yes" />
      </Component>
      <Component Id="IconFile">
        <File Id="IconFile" Source="$(Icon)" Name="sinhala.ico" KeyPath="yes" />
      </Component>
      <Component Id="Dll32">
        <File Id="Dll32" Source="$(X86Dll)" Name="sinhala_tsf_x86.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- In a 64-bit package: System64Folder = System32 (64-bit), SystemFolder = SysWOW64 (32-bit). -->
    <CustomAction Id="Register64" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
        ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[INSTALLFOLDER]sinhala_tsf_x64.dll&quot;" />
    <CustomAction Id="Register32" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
        ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s &quot;[INSTALLFOLDER]sinhala_tsf_x86.dll&quot;" />
    <CustomAction Id="Unregister64" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
        ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[INSTALLFOLDER]sinhala_tsf_x64.dll&quot;" />
    <CustomAction Id="Unregister32" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
        ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /u /s &quot;[INSTALLFOLDER]sinhala_tsf_x86.dll&quot;" />

    <InstallExecuteSequence>
      <Custom Action="Unregister64" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="Unregister32" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="Register64" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="Register32" After="Register64" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
